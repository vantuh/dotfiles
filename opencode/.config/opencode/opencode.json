{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    "~/.config/opencode/caveman.md"
  ],
  "provider": {
    "llama-local": {
      "name": "llama.cpp (local)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "gemma4-26b-local": {
          "name": "Gemma 4 26B local",
          "tool_call": true,
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "gemma4-e4b-local": {
          "name": "Gemma 4 E4B local",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    "kiro-gateway": {
      "name": "Kiro Gateway",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:KIRO_GATEWAY_API_KEY}"
      },
      "models": {
        "claude-haiku-4.5": {
          "name": "Claude Haiku 4.5",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "claude-opus-4.6": {
          "name": "Claude Opus 4.6",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}