{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "instructions": [
    "~/.config/opencode/caveman.md"
  ],
  "provider": {
    "kiro-gateway": {
      "name": "Kiro Gateway",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "http://127.0.0.1:8000/v1",
        "apiKey": "{env:KIRO_GATEWAY_API_KEY}"
      },
      "models": {
        "claude-haiku-4.5": {
          "name": "Claude Haiku 4.5",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          }
        },
        "claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "claude-opus-4.6": {
          "name": "Claude Opus 4.6",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        }
      }
    }
  }
}