{
  "defaultProvider": "anthropic",
  "defaultModel": "claude-sonnet-5-5",
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-intercom",
    "npm:pi-prompt-template-model",
    "npm:pi-subagents",
    "git:github.com/DietrichGebert/ponytail",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@plannotator/pi-extension",
    "npm:@juicesharp/rpiv-ask-user-question",
    "git:github.com/obra/superpowers",
    "npm:pi-antigravity-acp-provider",
    "npm:pi-cursor-sdk"
  ],
  "lastChangelogVersion": "1.0.4",
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 16000
  },
  "theme": "dark",
  "enabledModels": [
    "simplex/qwen3.8-27b-exl3-3.0bpw",
    "openai/gpt-6.1-sol",
    "openai/gpt-6-luna",
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "cursor/grok-4.7@256k:slow",
    "openrouter/deepseek/deepseek-v4.1-flash"
  ],
  "defaultThinkingLevel": "medium",
  "kiroSubagentsBridge": {
    "enabled": false
  },
  "showHardwareCursor": false,
  "collapseChangelog": true,
  "tuiMode": "fullscreen",
  "subagents": {
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "anthropic/claude-opus-5-5",
        "anthropic/claude-sonnet-5-5",
        "cursor/grok-4.7@256k:slow",
        "inherit",
        "openai/gpt-6-luna",
        "openai/gpt-6.1-sol",
        "opencode-go/glm-5.3-flash"
      ],
      "agents": {
        "scout": {
          "allow": [
            "openai/gpt-6-luna"
          ]
        },
        "delegate": {
          "allow": [
            "cursor/grok-4.7@256k:slow"
          ]
        },
        "researcher": {
          "allow": [
            "openai/gpt-6.1-sol"
          ]
        },
        "worker": {
          "allow": [
            "cursor/grok-4.7@256k:slow"
          ]
        },
        "reviewer": {
          "allow": [
            "anthropic/claude-sonnet-5-5"
          ]
        },
        "oracle": {
          "allow": [
            "openai/gpt-6.1-sol"
          ]
        },
        "evidence-auditor": {
          "allow": [
            "openai/gpt-6.1-sol"
          ]
        },
        "council-codex": {
          "allow": [
            "openai/gpt-6.1-sol"
          ]
        },
        "council-opus": {
          "allow": [
            "anthropic/claude-opus-5-5"
          ]
        },
        "council-glm": {
          "allow": [
            "opencode-go/glm-5.3-flash"
          ]
        }
      }
    },
    "agentOverrides": {
      "scout": {
        "model": "openai/gpt-6-luna",
        "thinking": "minimal"
      },
      "delegate": {
        "model": "cursor/grok-4.7@256k:slow"
      },
      "researcher": {
        "model": "openai/gpt-6.1-sol",
        "extensions": [
          "~/.pi/agent/npm/node_modules/pi-web-access"
        ]
      },
      "reviewer": {
        "model": "anthropic/claude-sonnet-5-5"
      },
      "worker": {
        "model": "cursor/grok-4.7@256k:slow",
        "thinking": "high",
        "skills": [
          "tdd",
          "fix-sonar"
        ],
        "extensions": [
          "~/.pi/agent/extensions/oxc-auto",
          "~/.pi/agent/subagent-extensions/ponytail-full.ts"
        ]
      },
      "oracle": {
        "model": "openai/gpt-6.1-sol"
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      },
      "evidence-auditor": {
        "model": "openai/gpt-6.1-sol"
      },
      "council-codex": {
        "model": "openai/gpt-6.1-sol"
      }
    }
  },
  "deviceId": "faf2e207-5602-4512-b672-bf788257bea8"
}