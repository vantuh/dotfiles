          "hunk"
        ]
      },
      "worker": {
        "model": "openrouter/stealth/space-bunny-alpha",
        "thinking": "high",
        "skills": [
          "tdd",
          "vercel-react-best-practices",
          "fix-sonar"
        ],
        "extensions": [
          "~/.pi/agent/extensions/oxc-auto"
        ]
      },
      "oracle": {
        "model": "anthropic/claude-opus-5-5"
      },
      "claude-code": {
