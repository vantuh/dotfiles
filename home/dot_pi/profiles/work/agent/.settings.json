{
  "defaultProvider": "kiro-acp",
  "defaultModel": "claude-sonnet-5",
  "defaultTools": ["+codemode"],
  "packages": [
    "npm:pi-web-access",
    "npm:pi-autoname",
    "npm:pi-intercom",
    "npm:pi-prompt-template-model",
    "git:github.com/nicobailon/pi-subagents",
    "git:github.com/DietrichGebert/ponytail",
    "npm:@gotgenes/pi-anthropic-auth"
  ],
  "lastChangelogVersion": "0.99.2",
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 16000
  },
  "theme": "dark",
  "enabledModels": [
    "kiro-acp/auto",
    "kiro-acp/claude-opus-5.5",
    "kiro-acp/claude-sonnet-5",
    "kiro-acp/claude-haiku-4.5"
  ],
  "defaultThinkingLevel": "medium",
  "kiroSubagentsBridge": {
    "enabled": false
  },
  "showHardwareCursor": false,
  "collapseChangelog": true,
  "tuiMode": "fullscreen",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "kiro-acp/claude-haiku-4.5",
        "thinking": "minimal",
        "extensions": [
          "~/.pi/agent/extensions/kiro-acp"
        ]
      },
      "delegate": {
        "model": "kiro-acp/claude-sonnet-5"
      },
      "researcher": {
        "model": "kiro-acp/claude-sonnet-5",
        "extensions": [
          "~/.pi/agent/extensions/kiro-acp",
          "~/.pi/agent/npm/node_modules/pi-web-access"
        ]
      },
      "reviewer": {
        "model": "kiro-acp/claude-opus-5.5",
        "skills": [
          "hunk"
        ],
        "extensions": [
          "~/.pi/agent/extensions/kiro-acp"
        ]
      },
      "worker": {
        "model": "kiro-acp/claude-sonnet-5",
        "thinking": "medium",
        "skills": [
          "tdd",
          "vercel-react-best-practices",
          "fix-sonar"
        ],
        "extensions": [
          "~/.pi/agent/extensions/oxc-auto",
          "~/.pi/agent/extensions/kiro-acp"
        ]
      },
      "oracle": {
        "model": "kiro-acp/claude-opus-5.5"
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      },
      "evidence-auditor": {
        "model": "openai/gpt-6.1-sol"
      }
    }
  },
  "deviceId": "faf2e207-5602-4512-b672-bf788257bea8"
}