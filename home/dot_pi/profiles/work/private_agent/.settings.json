{
  "defaultProvider": "kiro-acp",
  "defaultModel": "claude-sonnet-5.5",
  "defaultTools": [
    "+codemode"
  ],
  "packages": [
    "npm:pi-web-access",
    {
      "source": "npm:pi-subagents",
      "prompts": ["prompts/council.md"]
    },
    "git:github.com/DietrichGebert/ponytail",
    "npm:@gotgenes/pi-anthropic-auth",
    "npm:@plannotator/pi-extension",
    "npm:@juicesharp/rpiv-ask-user-question"
  ],
  "lastChangelogVersion": "1.0.4",
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 16000
  },
  "theme": "dark",
  "enabledModels": [
    "kiro-acp/auto",
    "kiro-acp/claude-opus-5.5",
    "kiro-acp/claude-haiku-4.5",
    "kiro-acp/claude-sonnet-5.5"
  ],
  "defaultThinkingLevel": "medium",
  "kiroSubagentsBridge": {
    "enabled": false
  },
  "showHardwareCursor": false,
  "collapseChangelog": true,
  "tuiMode": "fullscreen",
  "subagents": {
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "inherit",
        "kiro-acp/claude-haiku-4.5",
        "kiro-acp/claude-sonnet-5.5",
        "kiro-acp/claude-opus-5.5",
        "openai/gpt-6.1-sol",
        "anthropic/claude-opus-5-5",
        "opencode-go/glm-5.3-flash"
      ],
      "agents": {
        "scout": {
          "allow": [
            "kiro-acp/claude-haiku-4.5"
          ]
        },
        "delegate": {
          "allow": [
            "kiro-acp/claude-sonnet-5.5"
          ]
        },
        "researcher": {
          "allow": [
            "kiro-acp/claude-sonnet-5.5"
          ]
        },
        "worker": {
          "allow": [
            "kiro-acp/claude-sonnet-5.5"
          ]
        },
        "reviewer": {
          "allow": [
            "kiro-acp/claude-opus-5.5"
          ]
        },
        "oracle": {
          "allow": [
            "kiro-acp/claude-opus-5.5"
          ]
        },
        "evidence-auditor": {
          "allow": [
            "openai/gpt-6.1-sol"
          ]
        },
        "council-codex": {
          "allow": [
            "openai/gpt-6.1-sol"
          ]
        },
        "council-opus": {
          "allow": [
            "anthropic/claude-opus-5-5"
          ]
        },
        "council-glm": {
          "allow": [
            "opencode-go/glm-5.3-flash"
          ]
        }
      }
    },
    "agentOverrides": {
      "scout": {
        "model": "kiro-acp/claude-haiku-4.5",
        "thinking": "minimal",
        "extensions": [
          "~/.pi/agent/extensions/kiro-acp"
        ]
      },
      "delegate": {
        "model": "kiro-acp/claude-sonnet-5.5"
      },
      "researcher": {
        "model": "kiro-acp/claude-sonnet-5.5",
        "extensions": [
          "~/.pi/agent/extensions/kiro-acp",
          "~/.pi/agent/npm/node_modules/pi-web-access"
        ]
      },
      "reviewer": {
        "model": "kiro-acp/claude-opus-5.5",
        "extensions": [
          "~/.pi/agent/extensions/kiro-acp"
        ]
      },
      "worker": {
        "model": "kiro-acp/claude-sonnet-5.5",
        "thinking": "medium",
        "skills": [
          "tdd",
          "fix-sonar"
        ],
        "extensions": [
          "~/.pi/agent/extensions/oxc-auto",
          "~/.pi/agent/extensions/kiro-acp"
        ]
      },
      "oracle": {
        "model": "kiro-acp/claude-opus-5.5"
      },
      "claude-code": {
        "disabled": true
      },
      "claude-code-writer": {
        "disabled": true
      },
      "codex-exec": {
        "disabled": true
      },
      "codex-exec-writer": {
        "disabled": true
      },
      "cursor-agent": {
        "disabled": true
      },
      "cursor-agent-writer": {
        "disabled": true
      },
      "evidence-auditor": {
        "model": "openai/gpt-6.1-sol"
      }
    }
  },
  "deviceId": "faf2e207-5602-4512-b672-bf788257bea8"
}