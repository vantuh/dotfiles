# Renamed to *.ts so bun shebang keeps the TypeScript extension.
.local/bin/herdr-focus-tab
.local/bin/herdr-nvim-edit
.local/bin/herdr-setup
.local/bin/herdr-tab-watcher

# Ghostty now uses the XDG path. A leftover Application Support copy would
# override ~/.config/ghostty/config.ghostty.
Library/Application Support/com.mitchellh.ghostty/config.ghostty
Library/Application Support/com.mitchellh.ghostty/config

# Lazygit is pinned to ~/.config/lazygit via CONFIG_DIR. Drop the macOS
# default so a leftover file is not used if CONFIG_DIR is unset.
Library/Application Support/lazygit/config.yml

# Herdr usage/cheatsheet plugins and the my-usage CLIs are archived; drop the
# applied copies so nothing launches them.
.config/herdr/plugins/my-usage
.config/herdr/plugins/nvim-cheatsheet
.local/bin/my-usage
.local/bin/my-usage-status

# The Pi kiro-acp extension now comes from the ~/projects/personal/pi-kiro-acp
# package; drop the copy this repository used to apply so only one loads.
.pi/agent/extensions/kiro-acp

# The work profile shares the renamed personal Pi subagents config.
.pi/profiles/work/agent/herdr-agents.json

# The dictation daemon and its CLI moved into Pi Pocket's local-dictation extension, its dependencies into the
# extension's folder.
.local/bin/pi-dictation.ts
.local/share/pi-dictation
.local/state/pi-dictation
