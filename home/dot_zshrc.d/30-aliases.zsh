# Aliases.
alias ncu="npx npm-check-updates -i"
alias lg="lazygit"
alias ld="lazydocker"
alias tf="terraform"
alias nvp='nvim'
alias nvim-lazy='NVIM_APPNAME=lazyvim nvim'
# alias pi='bun "$NVM_DIR/versions/node/$(node --version)/lib/node_modules/@earendil-works/pi-coding-agent/dist/cli.js"'
alias ompw='OMP_PROFILE=work omp'
alias piw='PI_CODING_AGENT_DIR="$HOME/.pi/profiles/work/agent" pi'
# Local services and the tailnet address of anything else: each CLI takes
# up|down|status (`tailnet-serve-url` takes a port instead).
alias piweb='piweb.ts'
alias hwui='hwui.ts'
alias dictate='pi-dictation.ts'
alias tailnet-serve-url='tailnet-serve-url.ts'
