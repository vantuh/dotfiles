# --- On-demand web UIs over Tailscale -----------------------------------

# Publish a loopback port to this tailnet over HTTPS and print its address.
# Idempotent: `tailscale serve` keeps its configuration across restarts, so the
# mapping is added only when it is missing. HTTPS is not cosmetic — installing
# the app on a phone, web push and the microphone all need a secure context.
function tailnet-serve-url() {
  local port="$1" https_port="${2:-443}" host
  tailscale serve status 2>/dev/null | command grep -q "http://127.0.0.1:$port$" \
    || tailscale serve --bg --https="$https_port" "http://127.0.0.1:$port" >/dev/null \
    || return 1
  host="$(tailscale status --json 2>/dev/null | jq -r '.Self.DNSName // empty' | sed 's/\.$//')"
  [[ -n "$host" ]] || return 1
  print -r -- "https://$host:$https_port"
}

# Start pi-web when it is needed and publish it to the tailnet.
# `piweb down` stops it, `piweb up` (default) starts and prints the address.
# Configuration lives in ~/.config/pi-web/env: PORT, PI_WEB_HOSTNAME,
# PI_WEB_ALLOWED_HOSTS, PI_WEB_PASSWORD, PI_WEB_IDLE_TIMEOUT_MS and
# PI_SUBAGENTS_PI_CODING_AGENT_PACKAGE_ROOT (subagents cannot spawn children
# under pi-web without it).
function piweb() {
  local env_file="$HOME/.config/pi-web/env" log="$HOME/.config/pi-web/pi-web.log"
  local port="30141" https_port="8443"

  if [[ ! -f "$env_file" ]]; then
    print -u2 "piweb: missing $env_file (needs at least PORT and PI_WEB_PASSWORD)"
    return 1
  fi
  local configured
  configured="$(command grep -E '^PORT=' "$env_file" | tail -1 | cut -d= -f2)"
  [[ -n "$configured" ]] && port="$configured"

  if [[ "$1" == down ]]; then
    local pids
    pids="$(lsof -nP -iTCP:"$port" -sTCP:LISTEN -t 2>/dev/null)"
    if [[ -n "$pids" ]]; then
      kill ${=pids} && print "piweb: stopped (pids: ${=pids})"
    else
      print "piweb: not running"
    fi
    return 0
  fi

  if curl -sf -o /dev/null -m 3 "http://127.0.0.1:$port/"; then
    print "piweb: already answering on 127.0.0.1:$port"
  else
    local bin="${commands[pi-web]:-$(command -v pi-web)}" node_bin="${commands[node]:-$(command -v node)}"
    if [[ -z "$bin" || -z "$node_bin" ]]; then
      print -u2 "piweb: pi-web and node must be on PATH"
      return 1
    fi
    # The env names the server and the sessions it starts; keep it out of this
    # shell, so the password is not inherited by every later command.
    (
      set -a
      source "$env_file"
      set +a
      builtin cd "$HOME" || exit 1
      nohup "$node_bin" "$bin" >>"$log" 2>&1 &!
    )
    local i
    for i in {1..40}; do
      curl -sf -o /dev/null -m 2 "http://127.0.0.1:$port/" && break
      sleep 0.5
    done
    if ! curl -sf -o /dev/null -m 2 "http://127.0.0.1:$port/"; then
      print -u2 "piweb: did not come up; last lines of $log:"
      tail -n 5 "$log" >&2
      return 1
    fi
    print "piweb: started (log: $log)"
  fi

  local url
  if url="$(tailnet-serve-url "$port" "$https_port")"; then
    print "piweb: $url"
    print "piweb: password is the PI_WEB_PASSWORD line in $env_file"
  else
    print -u2 "piweb: running, but publishing to the tailnet failed (is Tailscale up?)"
  fi
}

# Herdr's web ui bridge. Herdr's own startup hook cannot run it: its plugin
# commands inherit a PATH without bun, so the bridge is started from a shell.
# `hwui` starts and publishes it with a QR code, `hwui stop|status` pass through
# to the plugin's own subcommands.
function hwui() {
  local dir=( "$HOME"/.config/herdr/plugins/github/devswha.herdr-web-ui-*(N/) )
  if [[ -z "$dir[1]" ]]; then
    print -u2 "hwui: plugin not installed (herdr plugin install devswha/herdr-web-ui)"
    return 1
  fi
  case "${1:-up}" in
    up) ( builtin cd "$dir[1]" && bun scripts/plugin.ts start && bun scripts/plugin.ts phone ) ;;
    *)  ( builtin cd "$dir[1]" && bun scripts/plugin.ts "$1" ) ;;
  esac
}
