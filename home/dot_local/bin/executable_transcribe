#!/usr/bin/env bash
set -euo pipefail

# ──────────────────────────────────────────────────────────
#  transcribe — Transcribe audio files with WhisperMLX or WhisperX
#
#  Usage:
#    transcribe <audio_file> [output_dir] [options]
#
#  Examples:
#    transcribe recording.mp3
#    transcribe recording.mp3 /tmp/output
#    transcribe recording.mp3 --no-diarize
#
#  Environment:
#    HF_TOKEN  — HuggingFace token (required for diarization)
# ──────────────────────────────────────────────────────────

# ── Config ────────────────────────────────────────────────
WHISPERX_VENV="$HOME/whisperx-env"
WHISPERMLX_VENV="$HOME/whispermlx-env"
MODEL="large-v3-turbo"
LANGUAGE="uk"
AUTO_LANG=false
# auto: float16 on the NVIDIA backend
COMPUTE_TYPE="auto"
BATCH_SIZE=32
MIN_SPEAKERS=2
MAX_SPEAKERS=6
OUTPUT_FORMAT="txt"
# ──────────────────────────────────────────────────────────

usage() {
    echo "Usage: $0 <audio_file> [output_dir] [--no-diarize] [--json] [--lang <code>]"
    echo ""
    echo "Options:"
    echo "  --no-diarize   Skip speaker diarization"
    echo "  --json         Output JSON instead of TXT"
    echo "  --lang <code>  Language code (default: uk)"
    echo "  --speakers <min> <max>  Min/max speakers (default: 2 6)"
    echo "  --light        Low-priority mode: nice + small batch (lets you work while transcribing)"
    exit 1
}

# ── Parse args ────────────────────────────────────────────
AUDIO_FILE=""
OUTPUT_DIR=""
DIARIZE=true
LIGHT=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-diarize)
            DIARIZE=false
            shift
            ;;
        --light)
            LIGHT=true
            shift
            ;;
        --json)
            OUTPUT_FORMAT="json"
            shift
            ;;
        --lang)
            if [[ "$2" == "auto" ]]; then
                AUTO_LANG=true
            else
                LANGUAGE="$2"
            fi
            shift 2
            ;;
        --speakers)
            MIN_SPEAKERS="$2"
            MAX_SPEAKERS="$3"
            shift 3
            ;;
        --help|-h)
            usage
            ;;
        *)
            if [[ -z "$AUDIO_FILE" ]]; then
                AUDIO_FILE="$1"
            elif [[ -z "$OUTPUT_DIR" ]]; then
                OUTPUT_DIR="$1"
            else
                echo "Error: unexpected argument '$1'"
                usage
            fi
            shift
            ;;
    esac
done

if [[ -z "$AUDIO_FILE" ]]; then
    echo "Error: audio file is required"
    usage
fi

if [[ ! -f "$AUDIO_FILE" ]]; then
    echo "Error: file not found: $AUDIO_FILE"
    exit 1
fi

# Default output dir = same directory as input file
if [[ -z "$OUTPUT_DIR" ]]; then
    OUTPUT_DIR="$(dirname "$AUDIO_FILE")"
fi

# ── Select backend ────────────────────────────────────────
case "$(uname -s):$(uname -m)" in
    Darwin:arm64)
        BACKEND="whispermlx"
        ACTIVE_VENV="$WHISPERMLX_VENV"
        ;;
    Linux:*)
        if ! command -v nvidia-smi >/dev/null 2>&1 || ! nvidia-smi -L >/dev/null 2>&1; then
            echo "Error: this script supports Apple Silicon macOS or Linux with an NVIDIA GPU."
            exit 1
        fi
        BACKEND="whisperx"
        ACTIVE_VENV="$WHISPERX_VENV"
        ;;
    *)
        echo "Error: this script supports Apple Silicon macOS or Linux with an NVIDIA GPU."
        exit 1
        ;;
esac

if [[ ! -d "$ACTIVE_VENV" ]]; then
    echo "Error: $BACKEND environment not found at $ACTIVE_VENV"
    if [[ "$BACKEND" == "whispermlx" ]]; then
        echo "Install: python3.12 -m venv $ACTIVE_VENV && source $ACTIVE_VENV/bin/activate && pip install whispermlx"
    else
        echo "Install: python3.12 -m venv $ACTIVE_VENV && source $ACTIVE_VENV/bin/activate && pip install whisperx"
    fi
    exit 1
fi

source "$ACTIVE_VENV/bin/activate"

if ! command -v "$BACKEND" >/dev/null 2>&1; then
    echo "Error: $BACKEND is not installed in $ACTIVE_VENV"
    exit 1
fi

if [[ "$BACKEND" == "whisperx" ]]; then
    if ! python3 -c 'import torch, sys; sys.exit(not torch.cuda.is_available())'; then
        echo "Error: WhisperX environment cannot access the NVIDIA GPU."
        exit 1
    fi
    if [[ "$COMPUTE_TYPE" == "auto" ]]; then
        COMPUTE_TYPE="float16"
        echo "Compute type:  $COMPUTE_TYPE (NVIDIA GPU)"
    fi
fi

# ── Light mode: reduce load ───────────────────────────────
if $LIGHT; then
    if [[ "$BACKEND" == "whisperx" ]]; then
        BATCH_SIZE=4
        echo "Light mode:    ON (nice=15, batch_size=$BATCH_SIZE)"
    else
        echo "Light mode:    ON (nice=15)"
    fi
fi

# ── Build command ─────────────────────────────────────────
CMD=(
    "$BACKEND" "$AUDIO_FILE"
    --model "$MODEL"
    --output_format "$OUTPUT_FORMAT"
    --output_dir "$OUTPUT_DIR"
)

if [[ "$BACKEND" == "whisperx" ]]; then
    CMD+=(--device cuda --compute_type "$COMPUTE_TYPE" --batch_size "$BATCH_SIZE")
else
    CMD+=(--device mps)
fi

if ! $AUTO_LANG; then
    CMD+=(--language "$LANGUAGE")
fi

if $DIARIZE; then
    if [[ -z "${HF_TOKEN:-}" ]]; then
        echo "Warning: HF_TOKEN not set, diarization will fail."
        echo "Set it with: export HF_TOKEN=hf_..."
        exit 1
    fi
    CMD+=(
        --diarize
        --min_speakers "$MIN_SPEAKERS"
        --max_speakers "$MAX_SPEAKERS"
    )
fi

# ── Run ───────────────────────────────────────────────────
FILENAME="$(basename "$AUDIO_FILE")"
echo "Transcribing: $FILENAME"
echo "Output dir:   $OUTPUT_DIR"
echo "Format:       $OUTPUT_FORMAT"
echo "Diarize:      $DIARIZE"
echo "Backend:      $BACKEND"
if [[ "$BACKEND" == "whisperx" ]]; then
    echo "Compute type: $COMPUTE_TYPE"
fi
if $AUTO_LANG; then
    echo "Language:     auto (no --language flag)"
else
    echo "Language:     $LANGUAGE"
fi
echo "──────────────────────────────────────"

if $LIGHT; then
    nice -n 15 "${CMD[@]}"
else
    "${CMD[@]}"
fi

echo "──────────────────────────────────────"
echo "Done. Output in: $OUTPUT_DIR"
