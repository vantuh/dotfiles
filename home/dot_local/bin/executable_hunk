#!/usr/bin/env bash
set -euo pipefail

entrypoint="$HOME/.npm/_npx/hunkdiff/bin/hunk.cjs"

# Use Node directly instead of Bun
if ! command -v node &> /dev/null; then
  printf 'Node.js is not installed\n' >&2
  exit 127
fi
if [[ ! -f "$entrypoint" ]]; then
  printf 'hunkdiff is not installed; run: npm install --global hunkdiff\n' >&2
  exit 127
fi

exec node "$entrypoint" "$@"
