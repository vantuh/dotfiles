#!/bin/bash

# Extract audio from video files to 16kHz mono WAV (optimized for WhisperX)
# Usage: extract-audio [directory]
#        extract-audio file1.mp4 file2.mp4 ...
#        Supports drag & drop paths, file:// URLs, and quoted paths

set -e

EXTENSIONS=("mp4" "mov" "mkv" "avi" "webm")

normalize_path() {
  local p="$1"
  p="${p#\"}" ; p="${p%\"}"
  p="${p#\'}" ; p="${p%\'}"
  if [[ "$p" == file://* ]]; then
    p="${p#file://}"
    p="$(printf '%b' "${p//%/\\x}")"
  fi
  p="${p//\\/}"
  p="${p%"${p##*[![:space:]]}"}"
  printf '%s' "$p"
}

ARGS=()
for a in "$@"; do
  ARGS+=("$(normalize_path "$a")")
done

INPUT_DIR="${ARGS[0]:-.}"

FILES=()
if [[ -d "$INPUT_DIR" ]]; then
  for ext in "${EXTENSIONS[@]}"; do
    while IFS= read -r -d '' f; do
      FILES+=("$f")
    done < <(find "$INPUT_DIR" -maxdepth 1 -iname "*.${ext}" -print0)
  done
else
  FILES=("${ARGS[@]}")
fi

if [[ ${#FILES[@]} -eq 0 ]]; then
  echo "No video files found."
  exit 1
fi

echo "Found ${#FILES[@]} file(s)"
echo "---"

for f in "${FILES[@]}"; do
  out="${f%.*}.wav"

  # Count audio streams
  audio_streams=$(ffprobe -v error -select_streams a \
    -show_entries stream=index -of csv=p=0 "$f" 2>/dev/null | wc -l | tr -d ' ')

  if [[ "$audio_streams" -eq 0 ]]; then
    echo "SKIP (no audio): $f"
    continue
  fi

  if [[ "$audio_streams" -gt 1 ]]; then
    # Multiple audio streams (e.g. video call with separate tracks per participant)
    # Merge all streams with amix, then convert to mono
    inputs=""
    for ((i=0; i<audio_streams; i++)); do
      inputs+="[0:a:${i}]"
    done
    echo "[${audio_streams} audio streams -> amix -> mono] $f"
    ffmpeg -i "$f" -vn -filter_complex \
      "${inputs}amix=inputs=${audio_streams}:duration=longest" \
      -ar 16000 -ac 1 -c:a pcm_s16le "$out" -y -loglevel error
  else
    # Single audio stream — check channels
    channels=$(ffprobe -v error -select_streams a:0 \
      -show_entries stream=channels -of csv=p=0 "$f" 2>/dev/null)
    if [[ "$channels" -eq 1 ]]; then
      echo "[$channels ch -> mono] $f"
      ffmpeg -i "$f" -vn -ar 16000 -ac 1 -c:a pcm_s16le "$out" -y -loglevel error
    else
      echo "[$channels ch -> mono mix] $f"
      ffmpeg -i "$f" -vn -ar 16000 -ac 1 -af "pan=mono|c0=0.5*c0+0.5*c1" \
        -c:a pcm_s16le "$out" -y -loglevel error
    fi
  fi

  echo "  -> $out"
done

echo "---"
echo "Done."
