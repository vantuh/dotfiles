#!/bin/bash
# Generate a commit message via `omp commit --no-changelog --dry-run`.
# Uses modelRoles.commit (@commit). Progress stays captured; only the
# generated message is printed. Split plans are rejected: this helper feeds
# a single `git commit -F`.
# Body wrapped at 72 (git-style hanging indent on "- " bullets); subject as-is.
set -o pipefail
if git diff --staged --quiet; then
  echo "No staged changes"
  exit 1
fi
raw=$(omp commit --legacy --no-changelog --dry-run) || exit $?
if printf '%s\n' "$raw" | grep -qx 'Split commit plan (dry run):'; then
  echo "omp proposed a split commit; stage one concern and retry" >&2
  exit 1
fi
msg=$(printf '%s\n' "$raw" | awk '
  $0 == "Generated commit message:" { capturing = 1; next }
  capturing { print }
')
if [ -z "$msg" ]; then
  echo "Failed to generate commit message" >&2
  exit 1
fi
printf '%s\n' "$msg" | awk '
function wrapline(line,    base, cut, contIndent) {
  match(line, /^ */)
  base = substr(line, 1, RLENGTH)
  contIndent = base
  if (substr(line, RLENGTH + 1, 2) == "- ")
    contIndent = base "  "
  while (length(line) > 72) {
    cut = 72
    while (cut > length(base) + 1 && substr(line, cut, 1) != " ")
      cut--
    if (cut <= length(base) + 1)
      break
    printf "%s\n", substr(line, 1, cut - 1)
    line = contIndent substr(line, cut + 1)
  }
  print line
}
NR == 1 { print; next }
{ wrapline($0) }
'
