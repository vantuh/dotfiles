# Repository-only Neovim documentation
.config/nvim/AGENTS.md
.config/nvim/CHANGELOG.md
.config/nvim/PARITY-AUDIT-PROMPT.md
.config/nvim/README.md

# Pi source-only development files
.pi/agent/archive
.pi/agent/extensions/package.json
.pi/agent/extensions/package-lock.json
.pi/agent/extensions/caveman/test
.pi/agent/extensions/usage/test
.omp/agent/extensions/kiro-acp/test
.pi/agent/**/node_modules
.omp/agent/**/node_modules

# Pi Pocket's git-history: the module is a link to the source state (made by run_after_30-link-pi-pocket-git-history.sh),
# and its 10 MB @pierre/diffs renderer is read beside the real file, so neither is copied into the data folder.
.pi-pocket/extensions/git-history.ts
.pi-pocket/extensions/lib

# pi-dictation dependencies (installed by run_after_20-install-pi-dictation-deps.sh)
.local/share/pi-dictation/node_modules
.omp/agent/config.yml.lock
.omp/agent/.config.yml.lock
.omp/profiles/*/agent/config.yml.lock
.omp/profiles/*/agent/.config.yml.lock

{{- if ne .chezmoi.os "darwin" }}
# macOS-only applications
.config/karabiner
.config/ghostty
{{- end }}

{{- $isWSL := and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) }}
{{- if not $isWSL }}
.local/bin/llama-update
.config/llama-swap
{{- end }}
