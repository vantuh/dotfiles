#!/usr/bin/env bash
# Pi Pocket's local-dictation extension imports one native npm package from its browser module's folder, where Pi
# Pocket neither serves nor watches node_modules. node_modules stays out of the source state (see .chezmoiignore.tmpl)
# and is created here on the first apply.
set -u

app_dir="{{ .chezmoi.destDir }}/.pi-pocket/extensions/local-dictation"
[[ -f "$app_dir/package.json" ]] || exit 0
[[ -d "$app_dir/node_modules" ]] && exit 0

if ! command -v bun >/dev/null 2>&1; then
  printf 'skip local-dictation dependencies: bun not found\n' >&2
  exit 0
fi

( cd "$app_dir" && bun install ) || printf 'local-dictation: bun install failed\n' >&2
