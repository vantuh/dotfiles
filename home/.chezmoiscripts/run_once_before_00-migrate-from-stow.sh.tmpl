#!/usr/bin/env bash
set -euo pipefail

working_tree="{{ .chezmoi.workingTree }}"

normalize_path() {
  local path=$1 part normalized=
  local -a parts

  IFS=/ read -r -a parts <<< "$path"
  for part in "${parts[@]}"; do
    case "$part" in
      ""|.) ;;
      ..) normalized=${normalized%/*} ;;
      *) normalized="$normalized/$part" ;;
    esac
  done
  printf '%s\n' "${normalized:-/}"
}

remove_legacy_link() {
  local link=$1 actual parent suffix expected
  shift
  [[ -L "$link" ]] || return 0

  actual=$(readlink "$link")
  if [[ "$actual" != /* ]]; then
    parent=$(cd -P "$(dirname "$link")" && pwd)
    actual="$parent/$actual"
  fi
  actual=$(normalize_path "$actual")

  for suffix in "$@"; do
    expected=$(normalize_path "$working_tree/$suffix")
    if [[ "$actual" == "$expected" ]]; then
      rm -- "$link"
      printf 'Removed legacy Stow link: %s\n' "$link"
      return 0
    fi
  done
}

remove_legacy_link "$HOME/.zshrc" "zsh/.zshrc"
remove_legacy_link "$HOME/.zshenv" "zsh/.zshenv"
remove_legacy_link "$HOME/.zshrc.d" "zsh/.zshrc.d"
remove_legacy_link "$HOME/.local" "zsh/.local"
remove_legacy_link "$HOME/.local/bin" "zsh/.local/bin"
remove_legacy_link "$HOME/.config/yazi" "yazi/.config/yazi"
remove_legacy_link "$HOME/.config/herdr" "herdr/.config/herdr"
remove_legacy_link "$HOME/.config/hunk" "hunk/.config/hunk"
remove_legacy_link "$HOME/.config/nvim" "nvim/.config/nvim"
remove_legacy_link "$HOME/.config/lazyvim" "nvim/.config/lazyvim"
remove_legacy_link "$HOME/.config/karabiner" "karabiner/.config/karabiner"
remove_legacy_link "$HOME/.config/nvim-personal" \
  "nvim-personal/.config/nvim-personal" \
  "nvim/.config/nvim-personal"
remove_legacy_link "$HOME/Library/Application Support/com.mitchellh.ghostty" \
  "ghostty/Library/Application Support/com.mitchellh.ghostty"
remove_legacy_link "$HOME/.pi/agent/extensions" "pi/.pi/agent/extensions"
remove_legacy_link "$HOME/.omp/agent/extensions" "omp/.omp/agent/extensions"

timestamp=$(date +%Y%m%d-%H%M%S)
for target in \
  "$HOME/.pi/agent/pi-autoname.json" \
  "$HOME/.omp/agent/config.yml" \
  "$HOME/.omp/agent/kiro-acp.json"; do
  if [[ -f "$target" && ! -L "$target" ]]; then
    cp -p -- "$target" "$target.pre-chezmoi.$timestamp"
    printf 'Backed up existing file: %s\n' "$target"
  fi
done
