{{- $isWSL := and (eq .chezmoi.os "linux") (contains "microsoft" (.chezmoi.kernel.osrelease | lower)) -}}
{{- if or (eq .chezmoi.os "windows") $isWSL -}}
#!/usr/bin/env bash
# Copy the Windows Terminal settings template into the Windows-side LocalState.
# A copy rather than a symlink: Windows Terminal rewrites settings.json from its
# own UI, replacing a symlink with a regular file anyway.
set -euo pipefail

{{ if eq .chezmoi.os "windows" -}}
windows_user="${USERNAME:?}"
users_root="/c/Users"
{{- else -}}
windows_user=$(cmd.exe /C "echo %USERNAME%" 2>/dev/null | tr -d '\r')
[ -n "$windows_user" ] || exit 0
users_root="/mnt/c/Users"
{{- end }}

packages_dir="$users_root/$windows_user/AppData/Local/Packages"
local_state=$(find "$packages_dir" -maxdepth 2 -name LocalState -path '*WindowsTerminal*' -print -quit 2>/dev/null || true)
if [ -z "$local_state" ]; then
  printf 'Windows Terminal not found; skipping settings sync\n' >&2
  exit 0
fi

source_path="{{ .chezmoi.sourceDir }}/.chezmoitemplates/windows-terminal/settings.json"
target="$local_state/settings.json"
[ -f "$source_path" ] || { printf 'missing %s\n' "$source_path" >&2; exit 1; }

if ! cmp -s "$source_path" "$target"; then
  cp -- "$source_path" "$target"
  printf 'Synced Windows Terminal settings.json\n'
fi
{{- end -}}
