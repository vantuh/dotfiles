{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Rex stores font preferences in UserDefaults, not init.lua.
defaults write com.superlogical.rex Workspace.terminalFontName -string "JetBrainsMonoNL Nerd Font"
defaults write com.superlogical.rex Workspace.terminalFontStyle -string "Light"
defaults write com.superlogical.rex Workspace.terminalFontPointSize -float 14
defaults write com.superlogical.rex Workspace.terminalFontSmoothing -bool false
defaults write com.superlogical.rex Workspace.terminalStartupCommand -string ""
{{ end -}}
