onboarding = false

[theme]
name = "catppuccin"

auto_switch = false

[session]
resume_agents_on_restore = true

[keys]
prefix = ["ctrl+a", "ctrl+ф"]

settings = ""
workspace_picker = ["prefix+s", "prefix+і"]

navigate_workspace_up = ["up", "k", "л"]
navigate_workspace_down = ["down", "j", "о"]

new_tab = ["prefix+c", "prefix+с"]
rename_tab = ["prefix+comma", "prefix+б"]

previous_tab = "shift+left"
next_tab = "shift+right"

focus_pane_left = "alt+left"
focus_pane_right = "alt+right"
focus_pane_up = "alt+up"
focus_pane_down = "alt+down"

split_vertical = "prefix+|"
split_horizontal = "prefix+minus"

close_pane = ["prefix+x", "prefix+ч"]
zoom = ["prefix+z", "prefix+я"]
toggle_sidebar = ["prefix+b", "prefix+и"]

[keys.indexed]
tabs = "alt"
workspaces = "ctrl+shift"

[ui]
host_cursor = "native"
show_agent_labels_on_pane_borders = true
prompt_new_tab_name = false
tab_bar_position = "bottom"

status_indicators = "symbols"

[ui.sidebar.spaces]
row_gap = 1

[ui.sidebar.agents]
row_gap = 1
# pi-subagents publishes its active-run label via pane metadata state_text.
rows = [
  ["state_icon", "workspace", "tab"],
  ["agent", "state_text"],
]

[ui.toast]
delivery = "system"
{{- if eq .chezmoi.os "windows" }}

[terminal]
default_shell = 'C:\msys64\usr\bin\zsh.exe'
# MSYS2 zsh builds PATH in /etc/profile, reached only through /etc/zsh/zprofile,
# which a login shell alone reads.
shell_mode = "login"
{{- end }}
