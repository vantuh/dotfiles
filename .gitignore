# OS / editor
.DS_Store
Thumbs.db
*.swp
*~

# Dependencies / build
node_modules

# Local databases
*.db
*.db-shm
*.db-wal

# Secrets and local overrides (never commit)
.env
.env.*
!.env.example
.tokens
**/.tokens
home/dot_zshrc.d/99-local.zsh
home/dot_zcompdump*
secrets/
credentials*
*.pem
*.key
*.p12
id_rsa*
*.secret.json
*.private.json
*.local.json

# Logs and agent runtime
*.log
**/sessions/
**/.pi/sessions/
home/.agents/.pi/

# herdr runtime state (only config.toml is versioned)
home/dot_config/herdr/session.json
home/dot_config/herdr/*.sock

# Generated Kiro ACP bridge agent config
.kiro/agents/pi-kiro-*.json

# Generated by skill tools (circular symlink only)
home/.agents/skills/skills

# Editor backups
*.bak
# OMP atomic-write lock / quarantine beside the live-linked config
# (profiles/*/ too: ~/.omp/profiles/<name>/agent/config.yml is a symlink into source)
home/dot_omp/**/config.yml.lock
home/dot_omp/**/.config.yml.lock
home/dot_omp/**/.config.yml.broken-*
# Repo-local Pi runtime state; home/dot_pi stays versioned
/.pi/
