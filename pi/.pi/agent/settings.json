{
  "defaultProvider": "kiro-acp",
  "defaultModel": "claude-sonnet-5",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-autoname",
    "npm:pi-intercom",
    "npm:pi-prompt-template-model",
    "npm:pi-cursor-sdk",
    "npm:pi-subagents",
    "git:github.com/leblancfg/pi-ansi-themes"
  ],
  "lastChangelogVersion": "0.85.1",
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 16000
  },
  "theme": "ansi-dark",
  "enabledModels": [
    "kiro-acp/claude-haiku-4.5",
    "openai-codex/gpt-5.6-sol",
    "kiro-acp/auto",
    "kiro-acp/claude-sonnet-5",
    "kiro-acp/claude-opus-5",
    "local/qwen3.8-27b",
    "local/qwen3.8-27b-ridge",
    "cursor/grok-4.6",
    "cursor/composer-2-5",
    "openai-codex/gpt-6-astra",
    "opencode-go/glm-5.3-flash",
    "opencode-go/glm-5.3"
  ],
  "defaultThinkingLevel": "medium",
  "kiroSubagentsBridge": {
    "enabled": false
  },
  "showHardwareCursor": false,
  "collapseChangelog": true,
  "tuiMode": "fullscreen",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "kiro-acp/claude-haiku-4.5",
        "thinking": "minimal",
        "extensions": [
          "~/.pi/agent/extensions/kiro-acp"
        ]
      },
      "delegate": {
        "model": "kiro-acp/claude-sonnet-5"
      },
      "researcher": {
        "model": "kiro-acp/claude-sonnet-5",
        "extensions": [
          "~/.pi/agent/extensions/kiro-acp",
          "~/.pi/agent/npm/node_modules/pi-web-access"
        ]
      },
      "reviewer": {
        "model": "kiro-acp/claude-opus-5",
        "skills": [
          "hunk"
        ],
        "extensions": [
          "~/.pi/agent/extensions/kiro-acp"
        ]
      },
      "worker": {
        "model": "kiro-acp/claude-sonnet-5",
        "thinking": "medium",
        "skills": [
          "tdd",
          "vercel-react-best-practices",
          "fix-sonar"
        ],
        "extensions": [
          "~/.pi/agent/extensions/oxc-auto",
          "~/.pi/agent/extensions/kiro-acp"
        ]
      },
      "oracle": {
        "model": "kiro-acp/claude-opus-5"
      }
    }
  }
}