{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-cursor-sdk",
    "npm:@plannotator/pi-extension",
    {
      "source": "extensions/herdr-agents",
      "extensions": ["index.ts"],
      "prompts": ["prompts/*.md"]
    }
  ],
  "lastChangelogVersion": "0.80.3",
  "hideThinkingBlock": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 16000
  },
  "theme": "dracula",
  "enabledModels": [
    "openai-codex/gpt-5.5",
    "local/qwen3.6-27b",
    "local/qwen3.6-27b-kxl",
    "kiro-acp/claude-opus-4.8",
    "kiro-acp/claude-haiku-4.5",
    "cursor/composer-2-5",
    "local/gemma-4-12b",
    "local/gemma-4-26b",
    "kiro-acp/claude-sonnet-5"
  ],
  "defaultThinkingLevel": "high",
  "subagents": {
    "disableBuiltins": true
  },
  "showHardwareCursor": true,
  "collapseChangelog": true
}