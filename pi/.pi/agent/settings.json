{
  "defaultProvider": "kiro-acp",
  "defaultModel": "claude-opus-4.6",
  "packages": [
    "npm:pi-web-access",
    "npm:@plannotator/pi-extension",
    "disabled-npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "disabled-npm:pi-lens"
