{
  "defaultProvider": "cursor",
  "defaultModel": "composer-2-5",
  "packages": [
    {
      "source": "npm:pi-web-access",
      "skills": [
        "-skills/librarian/SKILL.md"
      ]
    },
    {
      "source": "npm:@plannotator/pi-extension",
      "skills": [
        "-skills/plannotator-setup-goal/SKILL.md",
        "-skills/plannotator-compound/SKILL.md",
        "-skills/plannotator-visual-explainer/SKILL.md"
      ]
    },
    {
      "source": "npm:pi-mcp-adapter",
      "extensions": [
        "-index.ts"
      ]
    },
    {
      "source": "npm:pi-subagents",
      "prompts": [
        "-prompts/gather-context-and-clarify.md",
        "-prompts/parallel-cleanup.md",
        "-prompts/parallel-context-build.md",
        "-prompts/parallel-handoff-plan.md",
        "-prompts/parallel-research.md",
        "-prompts/review-loop.md",
        "+prompts/parallel-review.md"
      ]
    },
    {
      "source": "npm:pi-lens",
      "extensions": [
        "-index.ts"
      ],
      "skills": [
        "-skills/ast-grep/SKILL.md",
        "-skills/lsp-navigation/SKILL.md"
      ]
    },
    "npm:pi-cursor-sdk"
  ],
  "lastChangelogVersion": "0.75.5",
  "hideThinkingBlock": false,
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 16000
  },
  "theme": "dark",
  "quietStartup": false,
  "enabledModels": [
    "openai-codex/gpt-5.5",
    "local/qwen3.6-27b",
    "local/qwen3.6-27b-kxl",
    "kiro-acp/claude-opus-4.6",
    "kiro-acp/claude-sonnet-4.6",
    "kiro-acp/claude-haiku-4.5",
    "cursor/composer-2-5"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "defaultThinkingLevel": "low",
  "subagents": {
    "disableBuiltins": true
  },
  "extensions": [
    "-extensions/kiro-region-fix.ts"
  ]
}