{
  "defaultProvider": "kiro-acp",
  "defaultModel": "claude-sonnet-5",
  "packages": [
    "npm:pi-web-access",
    "npm:pi-autoname",
    "npm:pi-intercom",
    "npm:pi-prompt-template-model",
    "npm:pi-cursor-sdk",
    "npm:pi-subagents"
  ],
  "lastChangelogVersion": "0.85.1",
  "hideThinkingBlock": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 8192,
    "keepRecentTokens": 16000
  },
  "theme": "dark",
  "enabledModels": [
    "kiro-acp/claude-haiku-4.5",
    "openai-codex/gpt-5.6-sol",
    "kiro-acp/auto",
    "kiro-acp/claude-sonnet-5",
    "kiro-acp/claude-opus-5",
    "openrouter/z-ai/glm-5.3-flash",
    "local/qwen3.8-27b",
    "local/qwen3.8-27b-ridge",
    "openrouter/deepseek/deepseek-v4-flash-0731",
    "cursor/grok-4.6",
    "cursor/composer-2-5"
  ],
  "defaultThinkingLevel": "medium",
  "kiroSubagentsBridge": {
    "enabled": false
  },
  "showHardwareCursor": false,
  "collapseChangelog": true,
  "tuiMode": "fullscreen",
  "subagents": {
    "agentOverrides": {
      "scout": {
        "model": "kiro-acp/claude-haiku-4.5"
      },
      "delegate": {
        "model": "kiro-acp/claude-sonnet-5"
      },
      "researcher": {
        "model": "kiro-acp/claude-sonnet-5"
      },
      "reviewer": {
        "model": "kiro-acp/claude-opus-5"
      },
      "worker": {
        "model": "kiro-acp/claude-sonnet-5"
      },
      "oracle": {
        "model": "kiro-acp/claude-opus-5"
      }
    }
  }
}
