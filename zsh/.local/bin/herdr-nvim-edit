#!/usr/bin/env bash
# Open a file in an existing Neovim: Snacks ($NVIM), Herdr nvim tab, or local nvim.
# Lazygit: os.edit / os.editAtLine. Args: [+LINE] FILE
set -euo pipefail

line=""
file=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    +*)
      line="${1#+}"
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      exec nvim ${line:+"+$line"} "$@"
      ;;
    *)
      file=$1
      shift
      break
      ;;
  esac
done

if [[ -z "${file:-}" ]]; then
  exec nvim ${line:+"+$line"} "$@"
fi

if command -v realpath >/dev/null 2>&1; then
  file=$(realpath "$file")
else
  file=$(cd "$(dirname "$file")" && pwd)/$(basename "$file")
fi

# Vim :edit fnameescape for common special chars
vim_escape() {
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/ /\\ /g' -e 's/#/\\#/g' -e 's/%/\\%/g' -e 's/|/\\|/g'
}

open_remote() {
  local server=$1
  nvim --server "$server" --remote-send 'q' >/dev/null 2>&1 || true
  nvim --server "$server" --remote-tab "$file"
  if [[ -n "$line" ]]; then
    nvim --server "$server" --remote-send ":${line}<CR>"
  fi
}

# Snacks / nested Neovim terminal: $NVIM is the parent listen address
if [[ -n "${NVIM:-}" ]]; then
  open_remote "$NVIM"
  exit 0
fi

# Outside Herdr → plain blocking nvim
if [[ "${HERDR_ENV:-}" != 1 ]] || ! command -v herdr >/dev/null 2>&1; then
  exec nvim ${line:+"+$line"} -- "$file"
fi

file_root=$(git -C "$(dirname "$file")" rev-parse --show-toplevel 2>/dev/null || true)

best=$(
  HERDR_WORKSPACE_ID="${HERDR_WORKSPACE_ID:-}" \
  FILE_ROOT="$file_root" \
  python3 - <<'PY'
import json, os, subprocess

ws = os.environ.get("HERDR_WORKSPACE_ID") or None
file_root = os.environ.get("FILE_ROOT") or ""

cmd = ["herdr", "pane", "list"]
if ws:
    cmd.extend(["--workspace", ws])
try:
    panes = json.loads(subprocess.check_output(cmd, text=True))["result"]["panes"]
except Exception:
    raise SystemExit(0)

def pgrep_children(pid: int) -> list[int]:
    try:
        out = subprocess.check_output(["pgrep", "-P", str(pid)], text=True)
        return [int(x) for x in out.split() if x.strip()]
    except Exception:
        return []

def descendants(pid: int) -> list[int]:
    found = []
    stack = [pid]
    seen = set()
    while stack:
        cur = stack.pop()
        if cur in seen:
            continue
        seen.add(cur)
        kids = pgrep_children(cur)
        found.extend(kids)
        stack.extend(kids)
    return found

def proc_comm(pid: int) -> str:
    try:
        return subprocess.check_output(["ps", "-o", "comm=", "-p", str(pid)], text=True).strip()
    except Exception:
        return ""

def git_root(path: str) -> str:
    if not path:
        return ""
    try:
        return subprocess.check_output(
            ["git", "-C", path, "rev-parse", "--show-toplevel"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except Exception:
        return ""

candidates = []
for pane in panes:
    try:
        info = json.loads(
            subprocess.check_output(
                ["herdr", "pane", "process-info", "--pane", pane["pane_id"]],
                text=True,
            )
        )["result"]["process_info"]
    except Exception:
        continue

    shell_pid = info.get("shell_pid")
    if not shell_pid:
        continue

    title = (pane.get("terminal_title_stripped") or pane.get("terminal_title") or "").lower()
    has_nvim = any(proc_comm(p) == "nvim" for p in descendants(int(shell_pid)))
    if not has_nvim and "nvim" not in title:
        continue

    pane_cwd = pane.get("cwd") or pane.get("foreground_cwd") or ""
    nvim_root = git_root(pane_cwd)
    same_root = bool(file_root and nvim_root and file_root == nvim_root)
    title_nvim = "nvim" in title
    score = (
        0 if same_root else 1,
        0 if title_nvim else 1,
        0 if has_nvim else 1,
        pane.get("pane_id") or "",
    )
    candidates.append((score, pane))

if not candidates:
    raise SystemExit(0)

candidates.sort(key=lambda c: c[0])
_, pane = candidates[0]
print(json.dumps({"tab_id": pane["tab_id"], "pane_id": pane["pane_id"]}))
PY
)

if [[ -z "${best:-}" ]]; then
  exec nvim ${line:+"+$line"} -- "$file"
fi

tab_id=$(printf '%s' "$best" | jq -r .tab_id)
pane_id=$(printf '%s' "$best" | jq -r .pane_id)
escaped=$(vim_escape "$file")

herdr tab focus "$tab_id" >/dev/null
# Leave insert/terminal/cmdline, then open the file in that nvim
herdr pane send-keys "$pane_id" escape escape >/dev/null
herdr pane send-text "$pane_id" ":edit ${escaped}" >/dev/null
herdr pane send-keys "$pane_id" enter >/dev/null
if [[ -n "$line" ]]; then
  herdr pane send-text "$pane_id" ":${line}" >/dev/null
  herdr pane send-keys "$pane_id" enter >/dev/null
fi
exit 0
